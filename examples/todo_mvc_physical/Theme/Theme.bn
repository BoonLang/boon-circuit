FUNCTION material(of) {
    of |> WHEN {
        NewTodoRowFrame => frame_material(of: of)
        TodoListFrame => frame_material(of: of)
        TodoRowFrame => frame_material(of: of)
        PanelFooterFrame => frame_material(of: of)
        __ => [
            ...get(request: Material[of: of])
            ...shared_material(of: of)
        ]
    }
}

FUNCTION checkbox_material() {
    [
        ...get(request: Material[of: CheckboxGlyph])
    ]
}

FUNCTION font(of) {
    get(request: Font[of: of])
}

FUNCTION text(of) {
    get(request: Text[of: of])
}

FUNCTION depth(of) {
    get(request: Depth[of: of])
}

FUNCTION elevation(of) {
    get(request: Elevation[of: of])
}

FUNCTION corners(of) {
    get(request: Corners[of: of])
}

FUNCTION lights() {
    get(request: Lights)
}

FUNCTION geometry() {
    get(request: Geometry)
}

FUNCTION sizing(of) {
    of |> WHEN {
        TouchTarget => 40
        ToggleControl => theme_sizing(of: of)
        IconContainer => 34
        EditingInputWidth => 405
        __ => theme_sizing(of: of)
    }
}

FUNCTION spacing(of) {
    of |> WHEN {
        TitlePanelGap => 0
        NewTodoInputInset => theme_spacing(of: of)
        Section => 10
        SwitcherBottomPush => 0
        __ => theme_spacing(of: of)
    }
}

FUNCTION spring_range(of) {
    get(request: SpringRange[of: of])
}

FUNCTION frame_material(of) {
    PASSED.theme_options.name |> WHEN {
        Classic => Classic/get(request: Material[of: of], PASS: PASSED.theme_options)
        __ => shared_material(of: of)
    }
}

FUNCTION theme_sizing(of) {
    get(request: Sizing[of: of])
}

FUNCTION theme_spacing(of) {
    get(request: Spacing[of: of])
}

FUNCTION get(request) {
    PASSED.theme_options.name |> WHEN {
        Classic => Classic/get(request: request, PASS: PASSED.theme_options)
        Professional => Professional/get(request: request, PASS: PASSED.theme_options)
        Glassmorphism => Glassmorphism/get(request: request, PASS: PASSED.theme_options)
        Neobrutalism => Neobrutalism/get(request: request, PASS: PASSED.theme_options)
        Neumorphism => Neumorphism/get(request: request, PASS: PASSED.theme_options)
    }
}

FUNCTION shared_material(of) {
    PASSED.theme_options.name |> WHEN {
        Classic => []

        __ => BLOCK {
            divider: PASSED.theme_options.name |> WHEN {
                Professional => PASSED.theme_options.mode |> WHEN {
                    Light => TEXT { #e5e8ee }
                    Dark => TEXT { #323840 }
                }
                Glassmorphism => PASSED.theme_options.mode |> WHEN {
                    Light => TEXT { #5f71882e }
                    Dark => TEXT { #b4c3eb29 }
                }
                Neobrutalism => PASSED.theme_options.mode |> WHEN {
                    Light => TEXT { #000000 }
                    Dark => TEXT { #f4f4f4 }
                }
                Neumorphism => PASSED.theme_options.mode |> WHEN {
                    Light => TEXT { #a8b2c23d }
                    Dark => TEXT { #ffffff14 }
                }
                __ => TEXT { #e5e8ee }
            }

            of |> WHEN {
                NewTodoRowFrame => [
                    height: 64
                    border_bottom: divider
                    border_bottom_width: PASSED.theme_options.name |> WHEN {
                        Neobrutalism => PASSED.theme_options.mode |> WHEN {
                            Light => 4
                            Dark => 2
                        }
                        __ => 1
                    }
                ]

                TodoListFrame => [
                    scroll: True
                    scrollbars: False
                ]

                TodoRowFrame => [
                    height: 59
                    padding: 9
                    border_bottom: divider
                    border_bottom_width: PASSED.theme_options.name |> WHEN {
                        Neobrutalism => PASSED.theme_options.mode |> WHEN {
                            Light => 4
                            Dark => 2
                        }
                        __ => 1
                    }
                ]

                PanelFooterFrame => [
                    height: 49
                    border_top: divider
                    border_top_width: PASSED.theme_options.name |> WHEN {
                        Neobrutalism => PASSED.theme_options.mode |> WHEN {
                            Light => 4
                            Dark => 2
                        }
                        __ => 1
                    }
                ]

                __ => []
            }
        }
    }
}
