name = "change_probe"
source = "change_probe.bn.txt"

[[step]]
id = "initial"
  [step.expect_root_text]
  "store.count" = "0"
  "store.count_changes" = "?"
  "store.constant_changes" = "?"
  "store.seen_count" = "?"

[[step]]
id = "tick1"
expected_source_event = { source = "store.tick" }
  [step.expect_root_text]
  "store.count" = "1"
  "store.count_changes" = "?"
  "store.constant_changes" = "?"
  "store.seen_count" = "?"

[[step]]
id = "tick2"
expected_source_event = { source = "store.tick" }
  [step.expect_root_text]
  "store.count" = "2"
  "store.count_changes" = "?"
  "store.constant_changes" = "?"
  "store.seen_count" = "?"
