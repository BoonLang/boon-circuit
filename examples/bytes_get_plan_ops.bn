payload:
    BYTES[4] { 16u01, 16u02, 16uFE, 16u04 } |> HOLD payload { LATEST {} }

store: [
    measure: SOURCE
    selected_byte:
        BYTES[1] { 16u00 } |> HOLD selected_byte {
            LATEST {
                store.measure |> THEN {
                    payload
                    |> Bytes/get(position: 3)
                    |> WHEN {
                        Found[value] => value
                        NotFound => FLUSH { MissingBytePosition }
                    }
                }
            }
        }
]

document: Document/new(root: Element/label(element: [], label: TEXT { Bytes }))
