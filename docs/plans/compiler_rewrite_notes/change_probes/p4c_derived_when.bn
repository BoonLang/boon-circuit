store: [
    bump: SOURCE
    size:
        8 |> HOLD size {
            bump |> THEN { size + 1 }
        }
    derived_when: size > 9 |> WHEN {
        True => Random/bytes(byte_count: size)
        False => NotRequested
    }
]
document: Document/new(root: Element/label(element: [], style: [], label: store.size))
